{
  "name": "instantly-service",
  "version": "1.0.0",
  "description": "Cold email outreach service via Instantly.ai API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && npm run generate:openapi",
    "generate:openapi": "tsx scripts/generate-openapi.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "backfill:inferences": "tsx scripts/backfill-inferences.ts",
    "cleanup:stacked-sigs": "tsx scripts/cleanup-stacked-signatures.ts",
    "audit:dupes": "tsx scripts/audit-cross-campaign-dupes.ts",
    "heal:dupes": "tsx scripts/heal-pause-dupe-campaigns.ts",
    "cleanup:finished-contacts": "tsx scripts/cleanup-finished-contacts.ts",
    "cleanup:escaped-newlines": "tsx scripts/cleanup-escaped-newlines.ts",
    "cleanup:linked-footer": "tsx scripts/cleanup-linked-footer.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.4.0",
    "@shamanic-technologies/email-domain-contract": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.4",
    "express": "^4.21.2",
    "imapflow": "^1.7.1",
    "linkify-html": "^4.3.3",
    "linkifyjs": "^4.3.3",
    "mailparser": "^3.12.4",
    "nodemailer": "^10.2.1",
    "pg": "^8.16.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.12",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  }
}
